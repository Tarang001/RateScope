APP_ENV=local
LOG_LEVEL=INFO
API_KEY=ratescope-demo-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Local without Docker (default):
DATABASE_URL=sqlite+pysqlite:///./ratescope.local.db
# Hosted / Docker Postgres:
# DATABASE_URL=postgresql+psycopg2://ratescope:ratescope@localhost:5432/ratescope

REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

DEMO_MODE=true
OPENAI_API_KEY=

VITE_API_BASE_URL=/api/v1
VITE_API_KEY=ratescope-demo-key
